#!/usr/bin/env bash
# Refuse to push mactools if a submodule points at a commit its fork doesn't
# have yet (fresh clones would fail to check it out). Uses local refs only.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
bad=0
while read -r _ sha path; do
  [[ -d "$path/.git" || -f "$path/.git" ]] || continue   # not checked out (e.g. wox on a Mac)
  branch="$(git config -f .gitmodules "submodule.$path.branch" || echo main)"
  if ! git -C "$path" merge-base --is-ancestor "$sha" "origin/$branch" 2>/dev/null; then
    echo "pre-push: $path is at ${sha:0:9}, which isn't on origin/$branch. Push the fork first:" >&2
    echo "  git -C $path push origin $branch" >&2
    bad=1
  fi
done < <(git ls-tree -r HEAD | awk '$2 == "commit" {print $1, $3, $4}')
exit $bad
